type Handler = func(context.Context, Entities, UpdateClass) error

// UpdateDispatcher dispatches updates to registered handlers.
//
// Copies of UpdateDispatcher share registered handlers, so it is safe to
// pass it by value and to register handlers (including fallback) after the
// copy was made or while updates are dispatched.
//
// Use NewUpdateDispatcher to create UpdateDispatcher; zero value is not usable.
type UpdateDispatcher struct {
	state *dispatcherState
}

// NewUpdateDispatcher creates new UpdateDispatcher.
func NewUpdateDispatcher() UpdateDispatcher {
    return UpdateDispatcher{
        state: newDispatcherState(),
    }
}

type Entities struct {
	Short    bool
	Users    map[int64]*User
	Chats    map[int64]*Chat
	Channels map[int64]*Channel
}

// EntitiesFrom creates Entities from users and chats, e.g. from fields
// of Updates, UpdatesDifference or MessagesMessages.
func EntitiesFrom(users []UserClass, chats []ChatClass) Entities {
	c := ChatClassArray(chats)
	return Entities{
		Users:    UserClassArray(users).NotEmptyToMap(),
		Chats:    c.ChatToMap(),
		Channels: c.ChannelToMap(),
	}
}

// EntitiesResult is a result that contains users and chats, like Updates,
// UpdatesDifference, MessagesMessages or MessagesDialogs.
type EntitiesResult interface {
	MapUsers() UserClassArray
	MapChats() ChatClassArray
}

// EntitiesFromResult creates Entities from users and chats of result.
func EntitiesFromResult(r EntitiesResult) Entities {
	chats := r.MapChats()
	return Entities{
		Users:    r.MapUsers().NotEmptyToMap(),
		Chats:    chats.ChatToMap(),
		Channels: chats.ChannelToMap(),
	}
}

func (u *Entities) short() {
	u.Short = true
	u.Users = make(map[int64]*User, 0)
	u.Chats = make(map[int64]*Chat, 0)
	u.Channels = make(map[int64]*Channel, 0)
}

// Handle implements UpdateDispatcher.
func (u UpdateDispatcher) Handle(ctx context.Context, updates UpdatesClass) error {
	var (
		e Entities
		upds []UpdateClass
	)
	switch u := updates.(type) {
	case *Updates:
		upds = u.Updates
		e = EntitiesFromResult(u)
	case *UpdatesCombined:
		upds = u.Updates
		e = EntitiesFromResult(u)
	case *UpdateShort:
		upds = []UpdateClass{u.Update}
		e.short()
	default:
		// *UpdateShortMessage
		// *UpdateShortChatMessage
		// *UpdateShortSentMessage
		// *UpdatesTooLong
		return nil
	}

	var err error
	for _, update := range upds {
		multierr.AppendInto(&err, u.dispatch(ctx, e, update))
	}
	return err
}

func (u UpdateDispatcher) dispatch(ctx context.Context, e Entities, update UpdateClass) error {
    if update == nil {
        return nil
    }
	before, handler := u.state.handler(update.TypeID())
	if before != nil {
		if err := before(ctx, e, update); err != nil {
			return err
		}
	}
	if handler == nil {
		return nil
	}
	return handler(ctx, e, update)
}

